# ==============================================================================
# آيَة | AYAH QUEST - ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# ==============================================================================
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# Configure these in Cloudflare Dashboard -> Workers -> Settings -> Variables & Secrets.

# ------------------------------------------------------------------------------
# 1. TELEGRAM BOT SECRETS & IDS
# ------------------------------------------------------------------------------
# Obtained from @BotFather on Telegram
BOT_TOKEN=

# Admin Telegram numeric ID (Default: 6545688842)
ADMIN_TELEGRAM_ID=6545688842

# Telegram webhook secret token (Random alphanumeric string, min 16 chars)
TELEGRAM_WEBHOOK_SECRET=

# Secret token used to call /api/setup-webhook securely
WEBHOOK_SETUP_SECRET=

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE & REST CREDENTIALS
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. APP & PAYMENT CONFIGURATION
# ------------------------------------------------------------------------------
# The hosted URL of the frontend Telegram Mini App
FRONTEND_URL=https://quran-ayah-quiz.vercel.app

# Support contact handle (Default: @luck_7n)
SUPPORT_USERNAME=@luck_7n

# Telebirr payment details
TELEBIRR_NUMBER=0938054751
TELEBIRR_NAME=Lakin
TELEBIRR_ETB=50

# Telegram Stars Pro pricing
